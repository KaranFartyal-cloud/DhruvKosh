# Publishing Configuration
# Set to 'live' to actually post to social media. Default is 'dry_run'.
PUBLISH_MODE=dry_run

# If true, approving a post will immediately publish it to configured platforms.
AUTO_PUBLISH_ON_APPROVE=false

# Telegram Configuration
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel ID (usually starts with -100) or public @username
TELEGRAM_CHANNEL_ID=

# X (Twitter) Configuration
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Mastodon Configuration
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky Configuration
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Facebook Configuration
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
